# Twilio credentials for WhatsApp notifications
# Sign up at https://www.twilio.com/try-twilio to get these credentials
# After signing up, activate the WhatsApp Sandbox: https://www.twilio.com/console/sms/whatsapp/sandbox

# Your Twilio Account SID (found on your Twilio dashboard)
TWILIO_ACCOUNT_SID=your_account_sid_here

# Your Twilio Auth Token (found on your Twilio dashboard)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (format: +14155238886)
# The system will add the 'whatsapp:' prefix automatically
TWILIO_FROM_NUMBER=+14155238886

# Your personal WhatsApp number that will receive notifications (format: +919876543210)
# The system will add the 'whatsapp:' prefix automatically
TWILIO_TO_NUMBER=+919876543210

# ------------------------------------------------------------------------------

# Zerodha credentials for trading API access
# Sign up at https://kite.zerodha.com/ and create an API key at https://kite.trade/
# These credentials are required for fetching market data and placing trades

# Your Zerodha API Key
API_KEY=your_zerodha_api_key_here

# Your Zerodha API Secret
API_SECRET=your_zerodha_api_secret_here 